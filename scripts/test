#!/usr/bin/env perl
# Repository test entrypoint: runs the prove suite under t/.
#
# Environment:
#   NOISEMAKER_CPU_DIR — path to a pinned noisemaker-for-cpu checkout
#     (revision per scripts/oracle-lock.json). When set, the cross-language
#     parity harness (scripts/parity.pl) is also run and must pass.
#     Without it, t/05-parity.t skips and only in-container tests run.

use strict;
use warnings;
use Cwd         qw(getcwd);
use File::Spec;
use FindBin;

my $fail = 0;
my $repo = $FindBin::Bin;

chdir(File::Spec->catdir($repo, '..')) or die "cannot cd to repository root: $!\n";
my $root = getcwd();

# NM_CHANGED_FILES — one changed path per line, from the supervisor. When set,
# run only the t/ tests that reference those paths (by full path or basename)
# so the changed code is exercised within a bounded invocation; every matched
# test still runs. Unset runs the whole suite as before.
my @tests = grep { -f } glob 't/*.t';
my $scoped = 0;
if (defined $ENV{NM_CHANGED_FILES} && $ENV{NM_CHANGED_FILES} =~ /\S/) {
    my @changed = grep { /\S/ } split /\n/, $ENV{NM_CHANGED_FILES};
    my %selected;
    for my $t (@tests) {
        open my $fh, '<', $t or die "cannot read $t: $!\n";
        local $/;
        my $content = <$fh>;
        close $fh;
        for my $f (@changed) {
            (my $base = $f) =~ s{.*/}{};
            if (index($content, $f) >= 0
                || (length($base) >= 8 && $base ne $f && index($content, $base) >= 0)) {
                $selected{$t} = 1;
                last;
            }
        }
    }
    @tests = sort keys %selected;
    $scoped = 1;
    print "NM_CHANGED_FILES set: running only tests referencing changed paths\n";
    unless (@tests) {
        print "No t/ test references the changed paths; nothing to run\n";
        exit 0;
    }
}

# NM_SHARD_INDEX / NM_SHARD_COUNT — run only this shard's round-robin slice
# of the test list, so a set of shard invocations together runs every such
# test while each invocation stays within the bounded time cap. Both
# variables must be set, and the count must match .nm-test-shards at the
# repository root when that file exists.
my $sharded = 0;
if (defined $ENV{NM_SHARD_INDEX} && defined $ENV{NM_SHARD_COUNT}) {
    my $index = $ENV{NM_SHARD_INDEX};
    my $count = $ENV{NM_SHARD_COUNT};
    die "NM_SHARD_INDEX must be a non-negative integer\n" unless $index =~ /^\d+$/;
    die "NM_SHARD_COUNT must be a positive integer\n" unless $count =~ /^\d+$/ && $count > 0;
    my $shard_file = File::Spec->catfile($root, '.nm-test-shards');
    if (-f $shard_file) {
        open my $sf, '<', $shard_file or die "cannot read $shard_file: $!\n";
        my $declared = <$sf>;
        close $sf;
        $declared //= '';
        $declared =~ s/\s+//g;
        die "NM_SHARD_COUNT $count does not match .nm-test-shards $declared\n"
            unless $declared eq $count;
    }
    die "NM_SHARD_INDEX $index is outside 0.." . ($count - 1) . "\n" if $index >= $count;
    @tests = map { $tests[$_] } grep { $_ % $count == $index } 0 .. $#tests;
    $sharded = 1;
    print "NM_SHARD_INDEX $index of $count: running shard $index of the test list\n";
    unless (@tests) {
        print "No tests assigned to shard $index; nothing to run\n";
        exit 0;
    }
}

print "== prove suite ==\n";
my @prove = ('prove', '-j2', '-lr');
if ($scoped || $sharded) { push @prove, @tests }
else { push @prove, 't' }
if (system(@prove) != 0) {
    print "FAIL: test suite reported failures\n";
    $fail = 1;
}

if ($ENV{NOISEMAKER_CPU_DIR}) {
    if ($scoped) {
        # NM_CHANGED_FILES mode: the full catalog sweep is unbounded
        # (~45 minutes), so it cannot fit the supervisor's 5-minute cap.
        # The selected tests already exercise the changed parity paths in
        # bounded form (t/05-parity.t runs the parity comparisons itself);
        # exact-source CI still runs the full sweep with the variable unset.
        print "\nSKIP: full cross-language parity sweep (NM_CHANGED_FILES set:\n";
        print "the selected tests exercise the changed parity paths in bounded\n";
        print "form; unset NM_CHANGED_FILES to run the full sweep)\n";
    }
    else {
        print "\n== cross-language parity vs $ENV{NOISEMAKER_CPU_DIR} ==\n";
        my @parity = ($^X, File::Spec->catfile($repo, 'parity.pl'));
        push @parity, '--size', $ENV{PARITY_SIZE} if $ENV{PARITY_SIZE};
        if (system(@parity) != 0) {
            print "FAIL: cross-language parity harness failed\n";
            $fail = 1;
        }
    }
}
else {
    print "\nSKIP: cross-language parity harness (set NOISEMAKER_CPU_DIR to a\n";
    print "pinned noisemaker-for-cpu checkout to enable it)\n";
}

exit $fail;
