#!/usr/bin/env perl

# Whole-port parity summary for noisemaker-for-perl. The authority's cases are
# the pinned noisemaker-for-cpu checkout's upstream-snapshot effect ids (the
# current authority manifest). Every case this port bundles is rendered by both
# engines through scripts/parity.pl and compared byte for byte; an authority
# id the port does not bundle counts as missing. Positional case ids
# (`synth/solid` or `synth__solid`) restrict the run to those cases.
#
# The last output line is:
#   PARITY-SUMMARY {"expected":N,"executed":N,"exact":N,"strict":N,"near":N,"defer":N,"skip":N,"fail":N,"missing":N}
#
#   expected  the authority's cases (manifest ids, or the requested subset)
#   executed  cases rendered by both engines and compared
#   exact     byte-identical RGBA8
#   strict    passes within the published numerical contract other than
#             exact: always 0, because the contract is byte-exact RGBA8
#   near      a bounded, visually reviewed difference at the reviewed oracle pin
#   defer, skip
#             always 0: no case is deferred or skipped
#   fail      an unaccepted rendered difference, a port runtime error, or an
#             oracle error
#   missing   authority cases this port does not bundle
#
# Exit 0 iff expected > 0 and every expected case is exact or reviewed near.
#
# Usage: perl scripts/parity-summary [--size N] [case-id ...]
#
# Uses NOISEMAKER_CPU_DIR (or a sibling noisemaker-for-cpu checkout) at the
# exact revision recorded in scripts/oracle-lock.json. When no configured
# checkout verifies against the lock, the script clones that revision into a
# writable cache root (NOISEMAKER_ORACLE_CACHE, /state/cache, or ~/.cache;
# a private tempdir as a last resort) and verifies the clone against the
# recorded runtime digest, so a bare audit container can run the whole-port
# summary without manual setup.

use strict;
use warnings;
use FindBin;
use lib "$FindBin::Bin/../lib";
use lib $FindBin::Bin;
use ParityOracle qw(verify_oracle);
use JSON::PP qw(decode_json);
use File::Path qw(make_path remove_tree);
use File::Spec;
use File::Temp ();

use Math::Fractal::Noisemaker::Renderer qw(meta);

my @requested;
my @pass_through;
for (my $i = 0; $i <= $#ARGV; $i++) {
    if ($ARGV[$i] eq '--size') { push @pass_through, '--size', $ARGV[++$i] }
    elsif ($ARGV[$i] =~ /^--/) { die "Unknown parity-summary option $ARGV[$i]\n" }
    else { (my $id = $ARGV[$i]) =~ s{__}{/}; push @requested, $id }
}

my $CPU_DIR = resolve_oracle();
my $pin = verify_oracle($CPU_DIR);
print "Reference: $pin->{revision} (runtime SHA-256 verified)\n";

# The authority manifest is read from the pinned checkout itself, so a pin bump
# cannot leave a stale copy of it in this repository.
my $TMP = File::Temp::tempdir(CLEANUP => 1);
my $probe = File::Spec->catfile($TMP, 'authority-manifest.mjs');
open my $pfh, '>', $probe or die "cannot write $probe: $!\n";
print {$pfh} <<'JS';
const { pathToFileURL } = await import('node:url')
const snapshot = await import(pathToFileURL(process.argv[2]).href)
process.stdout.write(JSON.stringify({ ids: snapshot.sourceEffectIds, revision: snapshot.UPSTREAM_REVISION }))
JS
close $pfh;
my $snapshot = File::Spec->catfile($CPU_DIR, 'src', 'effects', 'generated', 'upstream-snapshot.js');
my $manifest_json = `node "$probe" "$snapshot"`;
die "Failed to read the authority manifest from $snapshot\n" if $? != 0 || !$manifest_json;
my $authority = decode_json($manifest_json);
my @authority_ids = sort @{ $authority->{ids} };
die "Authority manifest is empty\n" unless @authority_ids;

my %known = map { $_ => 1 } @authority_ids;
if (my @unknown = grep { !$known{$_} } @requested) {
    die "Unknown parity-summary case @unknown: not one of the "
        . scalar(@authority_ids) . " authority-manifest effect IDs\n";
}
my %want = map { $_ => 1 } @requested;
my @ids = @requested ? grep { $want{$_} } @authority_ids : @authority_ids;
my $bundle = meta()->{effects};
my @executable = grep { $bundle->{$_} } @ids;
my @missing = grep { !$bundle->{$_} } @ids;

my ($exact, $near, $fail) = (0, 0, 0);
if (@executable) {
    # Capture parity.pl's report through a file: list-form piped opens are
    # not available on Windows.
    my $report = File::Spec->catfile($TMP, 'parity-report.txt');
    open my $saved_out, '>&', \*STDOUT or die "cannot save STDOUT: $!\n";
    open STDOUT, '>', $report or die "cannot write $report: $!\n";
    # parity.pl resolves the oracle the same way; hand the resolved checkout
    # down so a self-provisioned clone is used by the child process too.
    local $ENV{NOISEMAKER_CPU_DIR} = $CPU_DIR;
    system($^X, File::Spec->catfile($FindBin::Bin, 'parity.pl'),
        '--only', join(',', @executable), @pass_through);
    open STDOUT, '>&', $saved_out or die "cannot restore STDOUT: $!\n";
    open my $fh, '<', $report or die "cannot read $report: $!\n";
    my $output = do { local $/; <$fh> };
    close $fh;
    print $output;
    my ($passed, $total, $diffs, $errors, $oracle) = $output =~
        /^=== PARITY: (\d+)\/(\d+) pass \(byte-exact\)  \|  (\d+) diff  \|  (\d+) runtime-error  \|  (\d+) oracle-error ===$/m
        or die "parity-summary: could not parse scripts/parity.pl output\n";
    $exact = $passed;
    if ($output =~ /^NEAR: (\d+)$/m) { $near = $1 }
    else { die "parity-summary: could not parse scripts/parity.pl near count\n" }
    $fail = $diffs + $errors + $oracle;
}
printf "%-45s missing (not in this port's bundle)\n", $_ for @missing;

my @summary = (
    expected => scalar(@ids),
    executed => $exact + $near + $fail,
    exact    => $exact,
    strict   => 0,
    near     => $near,
    defer    => 0,
    skip     => 0,
    fail     => $fail,
    missing  => scalar(@missing),
    authorityRevision => $authority->{revision},
);
# The documented key order, which a hash would not keep.
my $json = JSON::PP->new->allow_nonref;
print 'PARITY-SUMMARY {'
    . join(',', map { $json->encode($summary[ 2 * $_ ]) . ':' . $json->encode($summary[ 2 * $_ + 1 ]) }
        0 .. $#summary / 2)
    . "}\n";
exit(@ids && $exact + $near == @ids && !$fail && !@missing ? 0 : 1);

# Where the pinned noisemaker-for-cpu oracle lives. NOISEMAKER_CPU_DIR wins
# when it verifies; a sibling checkout comes next; otherwise a bare container
# gets a clean clone of the exact pin revision, verified against the recorded
# runtime digest. A configured path that is missing or does not match the pin
# never blocks the run: it is reported and the resolution falls through, and
# the provisioned clone still has to pass the runtime-digest verification.
sub resolve_oracle {
    if (my $dir = $ENV{NOISEMAKER_CPU_DIR}) {
        return $dir if eval { verify_oracle($dir); 1 };
        print "NOISEMAKER_CPU_DIR $dir is not a usable pinned oracle: $@";
        print "falling back to a sibling checkout or a clean clone\n";
    }
    my $sibling = File::Spec->rel2abs(
        File::Spec->catdir($FindBin::Bin, '..', '..', 'noisemaker-for-cpu'));
    if (-e File::Spec->catfile($sibling, 'package.json')) {
        return $sibling if eval { verify_oracle($sibling); 1 };
        print "noisemaker-for-cpu sibling $sibling does not match oracle-lock.json: $@";
    }
    return provision_oracle();
}

# Clone the exact revision recorded in scripts/oracle-lock.json into a cache
# directory and verify it against the recorded runtime digest. The clone lives
# outside this repository; a pin bump provisions a fresh revision instead of
# reusing the stale one.
sub provision_oracle {
    my $lock = File::Spec->catfile($FindBin::Bin, 'oracle-lock.json');
    open my $fh, '<', $lock or die "cannot read $lock: $!\n";
    local $/;
    my $pin = decode_json(scalar <$fh>);
    close $fh;
    my $rev = $pin->{revision}
        or die "oracle-lock.json records no revision to provision\n";
    my $url = 'https://github.com/'
        . ($pin->{repository} || 'noisefactorllc/noisemaker-for-cpu') . '.git';

    my ($cache_root) = grep {
        defined && -d && -w
    } ($ENV{NOISEMAKER_ORACLE_CACHE}, '/state/cache',
       File::Spec->rel2abs(File::Spec->catdir($ENV{HOME} || File::Spec->curdir, '.cache')));
    if (!$cache_root) {
        # Last resort: a private tempdir. It lives for this run only, so a
        # runner without any persistent cache still pays one depth-1 clone.
        $cache_root = File::Temp::tempdir(CLEANUP => 0);
        print "no persistent writable cache root; provisioning the oracle into $cache_root\n";
    }
    my $base = File::Spec->catdir($cache_root, 'noisemaker-for-cpu-pin');
    my $target = File::Spec->catdir($base, $rev);
    return $target if eval { verify_oracle($target); 1 };

    File::Path::remove_tree($target) if -d $target;
    File::Path::make_path($base, { chmod => 0755 });
    my $staging = File::Spec->catdir($base, "staging-$$");
    my $cloned = eval {
        system('git', 'init', $staging) == 0
            or die "cannot init the oracle clone in $staging\n";
        system('git', '-C', $staging, 'remote', 'add', 'origin', $url) == 0
            or die "cannot add origin $url\n";
        system('git', '-C', $staging, 'fetch', '--depth', '1', 'origin', $rev) == 0
            or die "cannot fetch $rev from $url\n";
        system('git', '-C', $staging, 'checkout', '--detach', 'FETCH_HEAD') == 0
            or die "cannot check out the fetched $rev\n";
        1;
    };
    if (!$cloned or !eval { verify_oracle($staging); 1 }) {
        my $error = $@ || 'unknown error';
        remove_tree($staging);
        die "cannot provision the pinned noisemaker-for-cpu $rev: $error";
    }
    if (!rename($staging, $target) && !-d $target) {
        my $error = $!;
        remove_tree($staging);
        die "cannot install the oracle clone at $target: $error\n";
    }
    print "provisioned pinned noisemaker-for-cpu $rev at $target\n";
    return $target;
}
